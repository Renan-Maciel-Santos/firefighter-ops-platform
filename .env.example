# ==========================================================================
# .env.example — configuração da plataforma (demonstração com dados fictícios)
# ==========================================================================
# Copie para .env e preencha. O .env real NUNCA vai para o git (ver .gitignore).
# As variáveis marcadas OBRIGATÓRIA não têm valor padrão no código, de propósito:
# um padrão para senha é um segredo escrito no fonte.
# ==========================================================================

# ---------------------------------------------------------------- Postgres
# No docker-compose o webapp fala com o serviço "postgres" (PG_HOST e PG_PORT
# são sobrescritos lá). Do host, o Postgres da demo fica em localhost:55432 --
# porta e nome de banco diferentes do padrão de propósito, para um script
# rodado fora do container nunca cair num Postgres de verdade na 5432.
PG_HOST=localhost
PG_PORT=55432
PG_DB=demo_11gb
PG_USER=admin
PG_PASS=                      # OBRIGATÓRIA

# ------------------------------------------------------------ webapp (:8000)
# Chave que assina os tokens de sessão. Gere uma própria:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=               # OBRIGATÓRIA
JWT_EXPIRE_HOURS=8

# Porta do painel no host (docker-compose) e senha dos usuários do seed.
DEMO_PORT=8800
DEMO_SENHA=demo1234

# Token que o n8n envia no cabeçalho X-API-Token para as ferramentas da B.I.A.
# (/consulta/*). Necessário também para scripts/demo_bia.py e os testes.
N8N_TOKEN=

# ============ daqui para baixo: só para os ETLs de referência e a B.I.A. ====
# Nada disto é necessário para a demonstração.

# Mapa de força no Google Sheets (B3/mapa_operacional.py)
GOOGLE_SA_JSON=credentials/service-account.json
MAPA_FORCA_PLANILHA_ID=

# Geocodificação dos endereços de ocorrência (scripts B3/*coordenadas*.py)
GOOGLE_MAPS_API_KEY=

# Evolution API (WhatsApp da B.I.A.) — usada pelo bia_watchdog.py
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=bia

# n8n próprio da B.I.A. (n8n/docker-compose.yml)
N8N_PG_HOST=localhost
N8N_PG_PORT=5432
N8N_PG_DB=n8n_bia
N8N_PG_USER=n8n_bia_user
N8N_PG_PASS=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://n8n:5678/

# Avaliação de modelos (avaliacao_llm/): chave de um endpoint compatível com a
# API da OpenAI, só se for comparar com um modelo de nuvem. Modelos locais
# (Ollama) não precisam.
OPENAI_API_KEY=

# Backup cifrado (backup_11gb.py)
BACKUP_DIR=backups
BACKUP_DIR_2=
BACKUP_SENHA_2=

# Alerta do watchdog por e-mail e "dead man's switch" (healthchecks.io)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTA_EMAIL_PARA=
HEARTBEAT_URL=
